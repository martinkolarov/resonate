{
  "name": "@resonate/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev:api": "node --watch --import tsx --import ./src/infrastructure/observability/sentry.ts ./src/server.ts",
    "dev:worker": "node --watch --import tsx --import ./src/infrastructure/observability/sentry.ts ./src/worker.ts",
    "dev": "pnpm run --parallel \"/^dev:.*/\"",
    "start:api": "node --import ./dist/sentry.mjs ./dist/server.mjs",
    "start:worker": "node --import ./dist/sentry.mjs ./dist/worker.mjs",
    "start": "pnpm run --parallel \"/^start:.*/\"",
    "db:codegen": "kysely-codegen --config-file ./kysely-codegen.config.json",
    "db:codegen:check": "pnpm db:codegen --verify",
    "migrate:make": "kysely migrate make",
    "migrate:latest": "kysely migrate latest",
    "migrate:down": "kysely migrate down",
    "s3:smoke": "tsx ./scripts/s3-smoke.ts",
    "test": "tsx --test ./src/*.test.ts ./src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@resonate/contracts": "workspace:*",
    "@sentry/node": "^10.68.0",
    "bullmq": "^6.1.0",
    "cookie": "^2.0.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.21.0",
    "tsdown": "^0.22.12",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
